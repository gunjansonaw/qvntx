# All settings are optional - the defaults run the app against the live Elexon API.

# live     = fetch from Elexon on start-up; cache/snapshot only used if Elexon fails (default)
# snapshot = bundled snapshot only, no network (offline demos, CI)
DATA_MODE=live

# Month in which day-ahead purchase decisions are made (delivery = decision day + 1)
DECISION_MONTH=2026-01

# Elexon BMRS Insights API base URL (no API key required)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
HTTP_TIMEOUT_S=30
HTTP_RETRIES=3

# Where the last good live fetch is kept as a fallback (default backend/.cache, /tmp on Vercel)
# CACHE_DIR=/app/.cache

# Comma-separated origins allowed to call the API cross-origin (same-origin needs nothing)
CORS_ORIGINS=http://localhost:5173

# Serve the built React app from FastAPI (set automatically in the root Dockerfile)
# STATIC_DIR=../frontend/dist

# Enables POST /api/admin/refresh (header X-Admin-Token) to force a live re-fetch
# ADMIN_TOKEN=change-me

# Frontend only (build time): call an API on another origin
# VITE_API_BASE_URL=https://my-api.example.com
